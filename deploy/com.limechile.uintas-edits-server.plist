<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.limechile.uintas-edits-server</string>

    <!-- App-edits sync server (Mac Mini only — the sole DB writer). Long-running
         HTTP server on :8802 that receives status/jed_notes/trip_reports edits
         queued by the PWA on any device, applies them to uinta_lakes.db, and
         commits + pushes. Needs NO Full Disk Access (plain repo files + git).
         This machine's home is on an external /Volumes disk, so this plist must
         physically live on the INTERNAL disk (/Users/jed/Library/LaunchAgents)
         and is revived after reboot by com.limechile.agent-bootstrapper. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/OLAF-EXT/jedwoodx/repos/uintas/venv/bin/python3</string>
        <string>scripts/edits_server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/OLAF-EXT/jedwoodx/repos/uintas</string>

    <!-- A server, not a periodic job: keep it running, restart if it dies.
         ThrottleInterval stops a crash-loop from spinning hot (e.g. while the
         external volume is still mounting). -->
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Volumes/OLAF-EXT/jedwoodx</string>
        <key>PATH</key>
        <string>/Volumes/OLAF-EXT/jedwoodx/repos/uintas/venv/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jed/Library/Logs/uintas-edits-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jed/Library/Logs/uintas-edits-server.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
