  {
   "id": "t-mg02s5c0-89au",
   "updated": "2026-10-17T19:35:47.434Z",
   "title": "Hell Hole day hike w/ Chelsey",
   "planned": false,
   "date": "2025-09-26",
   "end_date": null,
   "when": null,
   "body": "Chelsey and I did a day hike in. Plenty of eager small cutthroats. Caught two on gulp minnows showing Chels how to use the spinning rod, then got everything ready to go out on my packraft with new fly rod, and then it started to hail and rain. After a while, I just packed everything up and got ready to leave, and of course, then it stopped raining. :-) I tried to find the old cabin ruins mentioned on RoadTripRyan but was unsuccessful.",
   "lakes": [
    "BR-29"
   ],
   "links": [
    {
     "url": "https://www.roadtripryan.com/go/t/utah/northern-utah/hell-hole-lake",
     "title": "Hell Hole Lake - Western Uintas - Road Trip Ryan"
    }
   ]
  },
