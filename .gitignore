tauri-app/src-tauri/target/
dist/
venv/
__pycache__/
*.pyc
.DS_Store

# Per-machine Claude Code settings (the shared config is .claude/settings.json)
.claude/settings.local.json

# Per-machine single-writer guard: presence = "this clone is a read-only mirror,
# never write/commit the DB" (see scripts/writer_guard.py). The Mini omits it.
.db-readonly

# Continuously regenerated by sync/update scripts — not worth tracking
firebase-debug.log
logs/combined_dump.txt
logs/notes_sync.log
logs/stocking_dump.txt
logs/stocking_update.log
# Pre-overwrite Apple Notes backups written by sync_db_to_notes_jxa.js
logs/notes_backups/
.playwright-cli/

# Cordell M. Andersen's self-published book (148MB scan) — derived data is
# committed (data/cma_*, DB seeds, cma_book.html, cma_photos/), the source PDF
# itself and the Tailscale-served compressed copy stay local-only
data/the-high-uinta-mountains-by-cma.pdf
data/cma-book-web.pdf
data/tailscale_book/

# Web Push secrets (Mini-only): VAPID private key + per-device subscription list.
# The repo is public — these MUST never be committed. The VAPID *public* key is
# embedded in index.html (public by design). See scripts/push_utils.py.
data/push/
