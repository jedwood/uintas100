#!/bin/bash
#
# Version-controlled pre-commit hook. Enable it once per clone with:
#     git config core.hooksPath .githooks
#
# It does two things:
#   1. Bumps the PWA cache version so installed home-screen apps pick up changes.
#   2. Whenever uinta_lakes.db is staged, regenerates the artifacts derived from
#      it so they can never silently drift from the DB:
#        - data/seeds/      reproducible CSV source (scripts/export_seeds.py)
#        - lakes_data.json  the JSON the PWA loads  (scripts/export_web_data.py)

set -e

# 1. PWA cache version — bump ONLY the CACHE_NAME line, and stage ONLY that
#    change. The working-tree file is bumped too (so a clean tree stays clean),
#    but what gets staged is the copy already in the index — HEAD's, or whatever
#    the committer deliberately staged — with the bump applied. It used to be
#    `git add service-worker.js`, which staged every in-progress edit to the
#    file, so the unattended commits (edits server, stocking cron) repeatedly
#    shipped half-finished worker rewrites. Those commits run against a private
#    index (scripts/auto_commit.py), and this hook honours it via GIT_INDEX_FILE.
NEW_VERSION="uintas-v$(date +%s)"
BUMP="s/^const CACHE_NAME = 'uintas-v[0-9]*';/const CACHE_NAME = '${NEW_VERSION}';/"
sed -i '' "${BUMP}" service-worker.js
BUMP_TMP="$(mktemp)"
git show :service-worker.js | sed "${BUMP}" > "${BUMP_TMP}"
BUMP_BLOB="$(git hash-object -w "${BUMP_TMP}")"
git update-index --cacheinfo "100644,${BUMP_BLOB},service-worker.js"
rm -f "${BUMP_TMP}"
echo "PWA cache version updated to: ${NEW_VERSION}"

# 2. Keep DB-derived artifacts in lockstep with the DB being committed
if git diff --cached --name-only | grep -qx 'uinta_lakes.db'; then
    echo "uinta_lakes.db staged — regenerating data/seeds/ and lakes_data.json ..."
    python3 scripts/export_seeds.py
    python3 scripts/export_web_data.py
    git add data/seeds/ lakes_data.json
fi
